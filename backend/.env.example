PORT=4000

# Firestore: path to the service account key downloaded from the Firebase console
# (Project settings > Service accounts). Never commit the key file.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Optional: defaults to the project_id in the key file
FIREBASE_PROJECT_ID=

# Optional: use the local Firestore emulator instead of a real project
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Secret used to sign login tokens. Use a long random string and never commit it.
JWT_SECRET=
# Optional: token lifetime, e.g. 1h, 7d. Defaults to 1d
JWT_EXPIRES_IN=

# Base URL of the trust-scoring Flask service. Defaults to http://127.0.0.1:5000
ML_SERVICE_URL=

# Optional: USD-based exchange rate feed for currency conversion. Defaults to https://open.er-api.com/v6/latest/USD
EXCHANGE_RATE_API_URL=

# M-Pesa Daraja (sandbox) credentials from https://developer.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
# Sandbox test shortcode; the matching passkey is on the Daraja STK Push simulate page
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
# Public HTTPS URL Daraja posts the result to (use a tunnel such as ngrok locally)
DARAJA_CALLBACK_URL=
# Optional: defaults to https://sandbox.safaricom.co.ke
DARAJA_BASE_URL=
# B2C payouts (worker withdrawals). Copy these from the Daraja Test Credentials page (select Sandbox):
# the shortcode is "Party A" and differs per account, so a wrong one is rejected as "security credential is locked"
DARAJA_B2C_SHORTCODE=
DARAJA_INITIATOR_NAME=testapi
# The initiator password encrypted with Safaricom's sandbox certificate, base64
DARAJA_SECURITY_CREDENTIAL=
# Random string put in the callback URLs below, since Daraja does not sign callbacks
DARAJA_B2C_CALLBACK_SECRET=
# Public HTTPS URLs, e.g. https://<tunnel>/api/payments/b2c/result/<secret> and .../b2c/timeout/<secret>
DARAJA_B2C_RESULT_URL=
DARAJA_B2C_TIMEOUT_URL=

# Used only by `npm run seed:admin` to create the first admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

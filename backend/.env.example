PORT=4000

# Firestore: path to the service account key downloaded from the Firebase console
# (Project settings > Service accounts). Never commit the key file.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Optional: defaults to the project_id in the key file
FIREBASE_PROJECT_ID=

# Optional: use the local Firestore emulator instead of a real project
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Secret used to sign login tokens. Use a long random string and never commit it.
JWT_SECRET=
# Optional: token lifetime, e.g. 1h, 7d. Defaults to 1d
JWT_EXPIRES_IN=

# Used only by `npm run seed:admin` to create the first admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

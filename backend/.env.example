PORT=4000

# Firestore: path to the service account key downloaded from the Firebase console
# (Project settings > Service accounts). Never commit the key file.
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Optional: defaults to the project_id in the key file
FIREBASE_PROJECT_ID=

# Optional: use the local Firestore emulator instead of a real project
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
